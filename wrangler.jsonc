// One Worker: static assets, /api/*, and (slice 12) the cron (Tech_Scope.md §2, ADR-0004).
{
  "name": "ember-tasks",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker first; every other path is served as a static asset, with the SPA fallback.
    "run_worker_first": ["/api/*"]
  },
  // Every minute: send what is due, then plan the stale users' days (worker/scheduler.ts). Daily at 19:00 UTC: retention (worker/retention.ts).
  "triggers": { "crons": ["* * * * *", "0 19 * * *"] }, // the scheduler tick; daily retention (03:00 Singapore)
  "vars": {
    // The app's own origin, for the link buttons in Telegram messages (Tech_Scope.md §6).
    "APP_ORIGIN": "https://ember-tasks.cron-telegram.workers.dev",
    // The Telegram bot's username, without the @ (Tech_Scope.md §6). Empty = Telegram linking is off. scripts/set-telegram.ps1 fills it.
    "TG_BOT_USERNAME": "",
    // Web push (slice 18, ADR-0002): the VAPID public key, base64url. Empty = web push is off. Not a secret: the browser needs
    // it to subscribe (GET /api/me returns it). The private half is the secret VAPID_PRIVATE_KEY and the contact is the
    // secret VAPID_SUBJECT (a mailto: URL); the three come from one key pair. See .dev.vars.example.
    "VAPID_PUBLIC_KEY": "BK3XbT_B7wciHAaw6ov_3asLZneNYxCWXcLBrV4sJjWcaAYLO55MmFvn02l0pBT7bReNsI3lMGYswVyuJaKG4jQ"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ember",
      // Production D1 "ember" (APAC), created 2026-10-02. Local dev and tests use a simulated database instead.
      "database_id": "a8be5a3e-9d5d-433a-87db-056553487768",
      "migrations_dir": "migrations"
    }
  ]
}
