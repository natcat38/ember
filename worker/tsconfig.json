{
  // Worker code and its tests. Runtime types come from `wrangler types` (generated by `npm run typecheck`, git-ignored);
  // there is no DOM lib here, so browser-only APIs fail to compile instead of failing in workerd.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["./**/*.ts"]
}
